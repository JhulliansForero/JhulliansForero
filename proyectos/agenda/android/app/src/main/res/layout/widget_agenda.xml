<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOY" android:textColor="@color/w_on_head_soft" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoy" android:textColor="@color/w_on_head" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_on_head_soft" android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/w_add" android:layout_width="38dp" android:layout_height="38dp" android:text="+" android:textColor="@color/w_on_head" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif" android:background="@drawable/widget_btn_on_head" android:gravity="center"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp" android:paddingTop="4dp">
        <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="7dp" android:paddingEnd="10dp" android:paddingBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/w_bar1" android:layout_width="4dp" android:layout_height="26dp" android:background="@color/w_cat_otro"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_text1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/w_check1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/w_accent" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif" android:layout_marginStart="8dp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="7dp" android:paddingEnd="10dp" android:paddingBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/w_bar2" android:layout_width="4dp" android:layout_height="26dp" android:background="@color/w_cat_otro"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_text2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_time2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/w_check2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/w_accent" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif" android:layout_marginStart="8dp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="7dp" android:paddingEnd="10dp" android:paddingBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/w_bar3" android:layout_width="4dp" android:layout_height="26dp" android:background="@color/w_cat_otro"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_text3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_time3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/w_check3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/w_accent" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif" android:layout_marginStart="8dp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="7dp" android:paddingEnd="10dp" android:paddingBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/w_bar4" android:layout_width="4dp" android:layout_height="26dp" android:background="@color/w_cat_otro"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_text4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_time4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/w_check4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/w_accent" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif" android:layout_marginStart="8dp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="7dp" android:paddingEnd="10dp" android:paddingBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/w_bar5" android:layout_width="4dp" android:layout_height="26dp" android:background="@color/w_cat_otro"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/w_text5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/w_time5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <TextView android:id="@+id/w_check5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/w_accent" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif" android:layout_marginStart="8dp" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nada para hoy. Toca + para agregar una actividad." android:textColor="@color/w_muted" android:textSize="13sp" android:fontFamily="sans-serif" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="10dp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/w_hab_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hábitos" android:textColor="@color/w_muted" android:textSize="12sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="10dp"/>
            <ProgressBar android:id="@+id/w_hab_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressDrawable="@drawable/w_progress_in"/>
            <TextView android:id="@+id/w_hab_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="10dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
