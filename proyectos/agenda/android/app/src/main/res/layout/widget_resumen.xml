<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:orientation="vertical">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESUMEN" android:textColor="@color/w_on_head_soft" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoy" android:textColor="@color/w_on_head" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_on_head_soft" android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/w_add" android:layout_width="38dp" android:layout_height="38dp" android:text="+" android:textColor="@color/w_on_head" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif" android:background="@drawable/widget_btn_on_head" android:gravity="center"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:id="@+id/t_hoy" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/widget_tile" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENDIENTES" android:textColor="@color/w_accent" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
                <TextView android:id="@+id/t_hoy_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/w_ink" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/t_hoy_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/t_hab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/widget_tile" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HÁBITOS" android:textColor="@color/w_accent" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
                <TextView android:id="@+id/t_hab_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0" android:textColor="@color/w_ink" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                    <ProgressBar android:id="@+id/t_hab_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="7dp" android:layout_weight="1" android:max="100" android:progress="0" android:progressDrawable="@drawable/w_progress_in"/>
                </LinearLayout>
                <TextView android:id="@+id/t_hab_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/t_fin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/widget_tile" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SALDO" android:textColor="@color/w_accent" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
                <TextView android:id="@+id/t_fin_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$ 0" android:textColor="@color/w_ink" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/t_fin_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/t_nota" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/widget_tile" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOTA" android:textColor="@color/w_accent" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1"/>
                <TextView android:id="@+id/t_nota_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/w_ink" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/t_nota_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="12sp" android:fontFamily="sans-serif" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
