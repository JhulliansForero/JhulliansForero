<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/note_bg_verde" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/w_eyebrow" android:layout_width="0dp" android:layout_height="wrap_content" android:text="NOTA" android:textColor="@color/w_accent" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:letterSpacing="0.1" android:layout_weight="1"/>
        <TextView android:id="@+id/w_add" android:layout_width="32dp" android:layout_height="32dp" android:text="+" android:textColor="@color/w_accent_ink" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif" android:background="@drawable/widget_btn" android:gravity="center"/>
    </LinearLayout>
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tus notas" android:textColor="@color/w_ink" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="0dp" android:text="Toca para crear tu primera nota." android:textColor="@color/w_ink" android:textSize="13sp" android:fontFamily="sans-serif" android:maxLines="10" android:ellipsize="end" android:layout_marginTop="6dp" android:layout_weight="1" android:lineSpacingMultiplier="1.15"/>
    <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/>
</LinearLayout>
